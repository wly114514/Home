# Copy this file to .env and replace every credential placeholder locally.
# No real API key, password, production domain or enrolled voice ID is included.

# Text generation: use the endpoint and model names supported by your provider.
AI_API_KEY=your-text-api-key
AI_BASE_URL=https://your-text-provider.example/v1
AI_COMPANION_MODEL=your-chat-model
AI_NOVEL_MODEL=your-novel-model
AI_TEXT_API_MODE=chat
AI_TEXT_ENDPOINT=
AI_TEXT_TIMEOUT_MS=180000
AI_TEXT_TOKEN_FIELD=max_tokens
AI_TEXT_TEMPERATURE=on

# Optional image generation.
AI_IMAGE_KEY=your-image-api-key
AI_IMAGE_ENDPOINT=https://your-image-provider.example/v1
AI_IMAGE_MODEL=your-image-model
AI_IMAGE_API_MODE=image
AI_IMAGE_FALLBACK_MODELS=
AI_IMAGE_RESPONSE_FORMAT=url
# AI_IMAGE_STANDARD_KEY=your-optional-standard-image-api-key
AI_IMAGE_STANDARD_ENDPOINT=
AI_IMAGE_STANDARD_MODEL=
AI_IMAGE_STANDARD_API_MODE=image
AI_IMAGE_STANDARD_FALLBACK_MODELS=
AI_IMAGE_STANDARD_RESPONSE_FORMAT=b64_json
AI_IMAGE_TIMEOUT_MS=240000
AI_IMAGE_CONCURRENCY=2

# Replace these with independent strong values before running production mode.
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
PAY_CALLBACK_SECRET=replace-with-a-separate-long-random-secret
ADMIN_TOKEN_EXPIRE_HOURS=12

# Local runtime paths; the server creates its own fresh database/media directories.
DB_PATH=app.db
GENERATED_IMAGES_DIR=assets/generated_images
GENERATED_AUDIO_DIR=assets/generated_audio
COMPANION_PRESETS_FILE=companion_presets.json
COMPANION_VOICE_CATALOG_FILE=companion_voice_catalog.json
PORT=8000
HOST=127.0.0.1
NODE_ENV=production
LOCAL_DEV=0
ALLOW_MOCK_PAYMENT=false
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional Turnstile: replace both placeholders when enabling.
# Leaving these placeholders uses the built-in image captcha.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Optional CosyVoice: fill your own API key and private per-character voice catalog.
# Leave MEDIA_TTS_PROVIDER empty to keep audio generation disabled.
MEDIA_TTS_PROVIDER=
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
COSYVOICE_MODEL=cosyvoice-v3.5-flash
COSYVOICE_TIMEOUT_MS=90000

# Optional vision: replace the placeholder key/model with your own available values.
DASHSCOPE_VISION_API_KEY=your-dashscope-vision-api-key
AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VISION_MODEL=your-vision-model
AI_VISION_TIMEOUT_MS=30000
COMPANION_ATTACHMENTS_DIR=.private/companion-attachments

# Payment integration placeholders; SDK checkout integration is not supplied.
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key
